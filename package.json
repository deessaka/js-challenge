    "@types/marked": "^5.0.2",
    "@types/react-query": "^1.2.9",
    "@vinejs/vine": "^4.3.0",
    "axios": "^1.13.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "dompurify": "^3.3.1",
    "edge.js": "^6.5.0",
    "framer-motion": "^12.34.3",
    "isolated-vm": "^7.0.1",
    "lodash": "^4.17.23",
    "lucide-react": "^0.575.0",
    "luxon": "^3.7.2",
    "marked": "^17.0.3",
    "next-themes": "^0.4.6",
    "pdf-parse": "^2.4.5",
    "pg": "^8.19.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-hook-form": "^7.71.2",
    "react-resizable-panels": "^4.6.5",
    "reflect-metadata": "^0.2.2",
    "resend": "^6.9.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.3.6",
    "zustand": "^5.0.11"
  },
  "hotHook": {
    "boundaries": [
      "./app/controllers/**/*.ts",
      "./app/middleware/*.ts"
    ]
  },
  "eslintConfig": {
    "extends": "@adonisjs/eslint-config/app"
  },
  "prettier": "@adonisjs/prettier-config"
}
