# App
NODE_ENV=development
PORT=3333
APP_KEY=
HOST=0.0.0.0
LOG_LEVEL=info
DOMAIN=http://localhost:3333
PUBLIC_APP_URL=http://localhost:3333

# Session
SESSION_DRIVER=cookie

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_DATABASE=js_challenge

# GitHub OAuth
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
# Optional: promote an existing verified user to super admin when running the seeder
ADMIN_EMAIL=

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Email Configuration
# Local dev: use MAIL_DRIVER=json — it never actually sends, MailService
# logs the rendered link instead, so registration/reset work without a
# real Resend/SMTP account. Use smtp or resend for staging/production.
MAIL_DRIVER=resend
MAIL_FROM_ADDRESS=onboarding@resend.dev
MAIL_FROM_NAME=Codojo
MAIL_REPLY_TO=onboarding@resend.dev
RESEND_API_KEY=re_xxxx_your_resend_api_key

# Optional SMTP Configuration (if using SMTP driver)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your-smtp-username
SMTP_PASSWORD=your-smtp-password
