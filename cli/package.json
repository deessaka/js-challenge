{
  "name": "@codojo/cli",
  "version": "0.1.0",
  "description": "Codojo — Terminal & TUI client for JavaScript katas",
  "type": "module",
  "main": "dist/main.js",
  "files": [
    "dist",
    "README.md"
  ],
  "bin": {
    "codojo": "./dist/main.js",
    "dojo": "./dist/main.js",
    "js-ch": "./dist/main.js",
    "js-challenge": "./dist/main.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json -w",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "keywords": [
    "codojo",
    "javascript",
    "terminal",
    "tui",
    "katas",
    "coding-challenges"
  ],
  "author": "",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.8",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "ink": "^5.1.0",
    "ink-select-input": "^6.0.0",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "react": "^19.0.0"
  }
}
