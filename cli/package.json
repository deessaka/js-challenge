{
  "name": "@js-challenge/cli",
  "version": "0.1.0",
  "description": "CLI terminal pour apprendre JavaScript avec JS Challenge.",
  "type": "module",
  "bin": {
    "js-ch": "./dist/main.js",
    "js-challenge": "./dist/main.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "dev": "node --loader ts-node/esm src/main.ts"
  },
  "dependencies": {
    "ink": "^7.1.1",
    "ink-select-input": "^6.2.0",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "react": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^25.3.2",
    "@types/react": "^19.2.18",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
