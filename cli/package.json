{
  "name": "@codojo/cli",
  "version": "0.1.2",
  "description": "Codojo — Terminal & TUI client for JavaScript katas",
  "type": "module",
  "main": "dist/main.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "codojo": "dist/main.js",
    "dojo": "dist/main.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "postbuild": "chmod +x dist/main.js",
    "test": "npm run build && node --test tests/*.test.mjs",
    "dev": "tsc -p tsconfig.json -w",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "keywords": [
    "codojo",
    "javascript",
    "terminal",
    "tui",
    "katas",
    "coding-challenges"
  ],
  "author": "Samuel De Essaka (Ekodev) <ekoledev@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ekole237/js-challenge.git",
    "directory": "cli"
  },
  "homepage": "https://codojo.ekodevs.com",
  "bugs": {
    "url": "https://github.com/Ekole237/js-challenge/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "19.2.18",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "ink": "7.1.1",
    "ink-select-input": "^6.0.0",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "react": "19.2.0"
  }
}
