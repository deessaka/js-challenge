{
  "extends": "@adonisjs/tsconfig/tsconfig.app.json",
  "compilerOptions": {
    "noEmitOnError": false,
    "rootDir": "./",
    "outDir": "./build",
    "paths": {
      "#app/*": [
        "./app/*"
      ],
      "#dto/*": [
        "./app/Dto/*js"
      ],
      "#constants/*": [
        "./CONST/*.js"
      ],
      "!@/*": [
        "./inertia/components/ui/*"
      ]
    }
  },
  "exclude": [
    "./inertia/**/*",
    "./cli/**/*",
    "./docs-site/**/*",
    "node_modules",
    "build"
  ]
}